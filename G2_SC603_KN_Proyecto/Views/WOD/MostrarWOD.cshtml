@model IEnumerable<G2_SC603_KN_Proyecto.Models.EjercicioResumen>
@{
    Layout = "_Layout";
    string rolActual = Context.Session.GetString("Rol") ?? string.Empty;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="toast show" style="background:#201f1f; color:#4ade80;">
        <span class="material-symbols-outlined">check_circle</span>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="toast show" style="background:#201f1f; color:#ffb4ab;">
        <span class="material-symbols-outlined">error</span>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<div id="page-wod" class="section-page active p-6 lg:p-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
        <div>
            <h2 class="font-headline text-3xl font-bold tracking-tight">WOD — Workout of the Day</h2>
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="WOD" asp-action="EntrenamientoDiario" class="btn-secondary py-2.5 text-sm">
                <span class="material-symbols-outlined text-[18px]">event_upcoming</span> WOD de Mañana
            </a>
            @if (rolActual.Contains("ADMIN") || rolActual.Contains("TRAINER"))
            {
                <button class="btn-primary py-2.5 text-sm" onclick="openWODModal()">
                    <span class="material-symbols-outlined text-[18px]">add</span> Publicar WOD
                </button>
            }
        </div>

    </div>

    <!-- WOD Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5" id="wodGrid">
        @{
            var wods = ViewBag.Wods as List<G2_SC603_KN_Proyecto.Models.WodResumen>;
            var wodGroups = wods != null && wods.Any()
            ? wods.GroupBy(w => w.IdRutina).ToList()
            : null;
        }
        @if (wodGroups != null && wodGroups.Any())
        {
            foreach (var grupo in wodGroups)
            {
                var primeraFila = grupo.First();
                <div class="bg-surface-container rounded-2xl p-5 shadow-[0_8px_24px_rgba(0,0,0,0.4)]">

                    <div class="flex items-start justify-between mb-1">
                        <h3 class="font-headline font-bold text-base">@primeraFila.Nombre</h3>
                            <div class="flex gap-1">
                                @if (rolActual.Contains("ADMIN") || rolActual.Contains("TRAINER"))
                                {
                                    <a asp-controller="WOD" asp-action="EditarWOD"
                                       asp-route-id="@primeraFila.IdRutina"
                                       class="btn-icon" title="Editar WOD">
                                        <span class="material-symbols-outlined text-[18px]">edit</span>
                                    </a>
                                }
                                @if (rolActual.Contains("ADMIN"))
                                {
                                    <button class="btn-icon" title="Eliminar WOD"
                                            onclick="confirmarEliminar(@primeraFila.IdRutina, '@primeraFila.Nombre.Replace("'", "\\'")')">
                                        <span class="material-symbols-outlined text-[18px] text-error">delete</span>
                                    </button>
                                }
                            </div>
                    </div>

                    @{
                        var fechasPorRutina = ViewBag.FechasPorRutina as Dictionary<int, DateOnly>;
                    }
                    @if (fechasPorRutina != null && fechasPorRutina.TryGetValue(primeraFila.IdRutina, out var fechaWod))
                    {
                        <p class="text-on-surface-variant text-xs mb-3 capitalize">
                            @fechaWod.ToString("dddd dd 'de' MMMM", new System.Globalization.CultureInfo("es-ES"))
                        </p>
                    }


                    @if (!string.IsNullOrEmpty(primeraFila.Imagen))
                    {
                        <img src="~/@primeraFila.Imagen" alt="@primeraFila.Nombre"
                             class="w-full rounded-xl" style="max-height:600px; width:100%; height:auto; display:block; object-fit:contain; margin:0 auto;" />
                    }
                    else
                    {
                        <p class="text-on-surface-variant text-xs">Sin imagen.</p>
                    }
                    <p class="text-xs text-outline mt-3">Coach: @primeraFila.NombreEntrenador</p>
                </div>
            }
        }
        else
        {
            <p class="text-on-surface-variant text-sm col-span-3">No hay WODs publicados aún.</p>
        }
    </div>
</div>

<!-- ===================== MODAL PUBLICAR WOD ===================== -->
<div class="modal-overlay" id="wodModal">
    <div class="modal-box" style="max-width:640px">
        <div class="flex items-center justify-between mb-6">
            <h3 class="font-headline font-bold text-xl">Publicar WOD</h3>
            <button onclick="closeModal('wodModal')" class="btn-icon">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form asp-action="AgregarWOD" method="post" enctype="multipart/form-data" id="wodForm" class="space-y-4">

            <div class="grid grid-cols-2 gap-4">
                <div class="col-span-2">
                    <label class="label-float">Nombre del Entrenamiento *</label>
                    <input type="text" name="nombre" id="wodNombre" class="input-field"
                           placeholder="Ej: AMRAP 20 — Fuerza y Cardio" required />
                </div>
                <div class="col-span-2">
                    <label class="label-float">Objetivo / Notas del Coach</label>
                    <textarea name="objetivo" id="wodObjetivo" class="input-field" rows="2"
                              placeholder="Instrucciones, tips, observaciones..."></textarea>
                </div>
                <div class="col-span-2">
                    <label class="label-float">Imagen del entrenamiento *</label>
                    <input type="file" name="imagen" id="wodImagen" class="input-field"
                           accept=".jpg,.jpeg,.png,.webp" required />
                    <p class="text-outline text-[11px] mt-1">Los clientes ven únicamente esta imagen, no hace falta cargar ejercicios por separado.</p>
                </div>
            </div>

            <!-- El WOD se comunica solo con la imagen, sin lista de ejercicios -->

            <div class="flex gap-3 pt-2 justify-end">
                <button type="button" class="btn-secondary" onclick="closeModal('wodModal')">Cancelar</button>
                <button type="submit" class="btn-primary">
                    <span class="material-symbols-outlined text-[16px]">publish</span> Publicar
                </button>
            </div>
        </form>
    </div>
    <form id="formEliminar" method="post" style="display:none">
        @Html.AntiForgeryToken()
    </form>
</div>

<script>
    // ---- ABRIR MODAL WOD ----
    function openWODModal() {
        document.getElementById('wodNombre').value = '';
        document.getElementById('wodObjetivo').value = '';
        document.getElementById('wodModal').classList.add('active');
    }

    // ---- CERRAR MODAL ----
    function closeModal(modalId) {
        document.getElementById(modalId).classList.remove('active');
    }
        // ---- CONFIRMAR ELIMINAR WOD ----
    function confirmarEliminar(id, nombre) {
        if (confirm('¿Eliminar el WOD "' + nombre + '"? Esta acción no se puede deshacer.')) {
            document.getElementById('formEliminar').action = '/WOD/EliminarWOD/' + id;
            document.getElementById('formEliminar').submit();
        }
    }

</script>
