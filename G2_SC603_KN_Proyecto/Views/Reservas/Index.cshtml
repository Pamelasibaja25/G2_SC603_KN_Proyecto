@model G2_SC603_KN_Proyecto.Models.ReservasViewModel
@{
    Layout = "_Layout";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="toast show" style="background:#201f1f; color:#4ade80;">
        <span class="material-symbols-outlined">check_circle</span>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="toast show" style="background:#201f1f; color:#ffb4ab;">
        <span class="material-symbols-outlined">error</span>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<div class="section-page active p-6 lg:p-8">
    <h2 class="font-headline text-3xl font-bold tracking-tight mb-8">Reservas</h2>

    @if (Model.EsCliente)
    {
        var pendiente = Model.WodPendienteActual;

        @if (pendiente != null)
        {
            <div class="bg-surface-container rounded-2xl overflow-hidden shadow-[0_20px_40px_rgba(0,0,0,0.3)] mb-8 p-6">
                <h3 class="font-headline font-bold text-xl mb-1">@pendiente.NombreWod</h3>
                <p class="text-on-surface-variant text-sm mb-4">
                    @pendiente.Fecha.ToString("dddd dd 'de' MMMM", new System.Globalization.CultureInfo("es-ES"))
                </p>
                @if (!string.IsNullOrEmpty(pendiente.Imagen))
                {
                    <img src="~/@pendiente.Imagen" alt="@pendiente.NombreWod" class="w-full rounded-xl mb-4"
                         style="max-height:560px; width:100%; height:auto; display:block; object-fit:contain; margin:0 auto;" />
                }
                <form asp-controller="WOD" asp-action="ConfirmarAsistenciaWOD" method="post" id="formAceptarWod">
                    <input type="hidden" name="idClienteRutina" value="@pendiente.IdClienteRutina" />
                    <input type="hidden" name="estado" value="ACEPTADO" />

                    <div class="bg-surface-container-high rounded-xl p-4 mb-4">
                        <p class="font-headline font-bold text-sm mb-1">¿A qué hora vas a llegar?</p>
                        <p class="text-on-surface-variant text-xs mb-4">Podés elegir más de una opción.</p>

                        <div class="horario-grid">
                            @foreach (string horario in HorariosWod.Opciones)
                            {
                                int votos = Model.VotosPorHorario.TryGetValue(horario, out int v) ? v : 0;
                                int max = Model.VotosPorHorario.Values.DefaultIfEmpty(0).Max();
                                int porcentaje = max == 0 ? 0 : (int)Math.Round(votos * 100.0 / max);

                                bool yaPaso = pendiente.Fecha == DateOnly.FromDateTime(DateTime.Today)
                                    && HorariosWod.ParseHora(horario) < TimeOnly.FromDateTime(DateTime.Now);

                                <label class="horario-chip @(yaPaso ? "horario-chip-disabled" : "")" style="--pct:@(porcentaje)%">
                                    <input type="checkbox" name="horarios" value="@horario" class="sr-only horario-checkbox" @(yaPaso ? "disabled" : "") />
                                    <span>@horario @(yaPaso ? "(ya pasó)" : "")</span>
                                    <span class="horario-chip-votes">@votos</span>
                                </label>
                            }
                        </div>

                        @if (Model.TotalVotantesHorario > 0)
                        {
                            <p class="text-on-surface-variant text-[11px] mt-3">@Model.TotalVotantesHorario persona(s) ya eligieron horario para este WOD.</p>
                        }
                    </div>

                    <div class="flex gap-3">
                        <button type="submit" class="btn-filled flex-1">Aceptar</button>
                    </div>
                </form>
                <form asp-controller="WOD" asp-action="ConfirmarAsistenciaWOD" method="post" class="mt-3">
                    <input type="hidden" name="idClienteRutina" value="@pendiente.IdClienteRutina" />
                    <input type="hidden" name="estado" value="NO_ASISTE" />
                    <button type="submit" class="btn-outlined w-full">No asistir</button>
                </form>
            </div>
        }

        <div class="bg-surface-container rounded-2xl overflow-hidden shadow-[0_20px_40px_rgba(0,0,0,0.3)] mb-8">
            <div class="p-6 pb-0 flex flex-wrap items-center justify-between gap-3">
                <h3 class="font-headline font-bold text-base">Mis confirmaciones</h3>
                <form method="get" asp-controller="Reservas" asp-action="Index" class="flex items-center gap-2">
                    <input type="month" name="mes" value="@Model.MesSeleccionado" class="input-field text-xs py-1.5" style="max-width:150px" />
                    <button type="submit" class="tab-btn text-xs py-1.5">Ver</button>
                </form>
            </div>
            <div class="overflow-x-auto">
                @if (!Model.MisConfirmaciones.Any())
                {
                    <p class="text-outline text-sm p-6 pt-4">No hay confirmaciones registradas para ese mes.</p>
                }
                else
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>WOD</th>
                                <th>Fecha</th>
                                <th>Horario</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.MisConfirmaciones)
                            {
                                <tr>
                                    <td>@c.NombreWod</td>
                                    <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@(string.IsNullOrEmpty(c.Horarios) ? "—" : c.Horarios.Replace(",", ", "))</td>
                                    <td>
                                        @if (c.Estado == "ACEPTADO")
                                        {
                                            <span class="tag ok">Confirmado</span>
                                        }
                                        else if (c.Estado == "NO_ASISTE")
                                        {
                                            <span class="tag no">No asistió</span>
                                        }
                                        else
                                        {
                                            <span class="tag mu">Pendiente</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }

    @if (Model.EsAdmin)
    {
        <div class="bg-surface-container rounded-2xl p-6 shadow-[0_20px_40px_rgba(0,0,0,0.3)] mb-8">
            <h3 class="font-headline font-bold text-base mb-1">Calendario de la Semana</h3>
            <p class="text-on-surface-variant text-xs mb-5">Quiénes confirmaron asistencia, día por día.</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-7 gap-3">
                @foreach (var dia in Model.Calendario)
                {
                    bool esHoyCal = dia.Fecha == DateOnly.FromDateTime(DateTime.Today);
                    <div class="bg-surface-container-high rounded-xl p-3 @(esHoyCal ? "ring-2 ring-primary-container" : "")">
                        <div class="flex items-center justify-between mb-2">
                            <span class="font-headline font-bold text-xs capitalize">
                                @dia.Fecha.ToString("dddd", new System.Globalization.CultureInfo("es-ES"))
                            </span>
                            <span class="text-outline text-[10px]">@dia.Fecha.ToString("dd/MM")</span>
                        </div>
                        @if (dia.Confirmados > 0)
                        {
                            <p class="text-primary-container text-[11px] font-semibold mb-2">@dia.Confirmados confirmado(s)</p>
                            <ul class="space-y-1 pr-1" style="max-height:140px; overflow-y:auto;">
                                @foreach (var cliente in dia.Clientes)
                                {
                                    <li class="text-xs flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[12px]">person</span>
                                        @cliente.Nombre
                                        @if (!string.IsNullOrEmpty(cliente.Horarios))
                                        {
                                            <span class="text-on-surface-variant text-[10px]">(@cliente.Horarios.Replace(",", ", "))</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-outline text-[11px]">Sin confirmaciones</p>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="bg-surface-container rounded-2xl overflow-hidden shadow-[0_20px_40px_rgba(0,0,0,0.3)] mb-8">
            <div class="p-6 pb-0 flex flex-wrap items-center justify-between gap-3">
                <h3 class="font-headline font-bold text-base">Asistencia de Hoy</h3>
                @if (Model.ConfirmadosHoy.Any())
                {
                    <select id="horarioFiltro" class="input-field text-xs py-1.5" style="max-width:180px" onchange="filtrarAsistenciaPorHorario()">
                        <option value="">Todos los horarios</option>
                        @foreach (string h in HorariosWod.Opciones)
                        {
                            <option value="@h">@h</option>
                        }
                    </select>
                }
            </div>
            <div class="overflow-x-auto">
                @if (!Model.ConfirmadosHoy.Any())
                {
                    <p class="text-outline text-sm p-6 pt-0">Nadie confirmó asistencia para hoy.</p>
                }
                else
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>WOD</th>
                                <th>Horario</th>
                                <th>Check-in</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="tablaAsistenciaHoy">
                            @foreach (var c in Model.ConfirmadosHoy)
                            {
                                <tr data-horarios="@c.Horarios">
                                    <td>@c.NombreCliente</td>
                                    <td>@c.NombreWod</td>
                                    <td>@(string.IsNullOrEmpty(c.Horarios) ? "—" : c.Horarios.Replace(",", ", "))</td>
                                    <td>
                                        @if (c.AsistioHoy)
                                        {
                                            <span class="tag ok">Ya ingresó</span>
                                        }
                                        else
                                        {
                                            <span class="tag mu">Pendiente</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!c.AsistioHoy)
                                        {
                                            <form asp-controller="Reservas" asp-action="RegistrarAsistencia" method="post">
                                                <input type="hidden" name="idClienteRutina" value="@c.IdClienteRutina" />
                                                <button type="submit" class="btn-secondary text-xs py-1.5 px-3">Marcar ingreso</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="bg-surface-container rounded-2xl overflow-hidden shadow-[0_20px_40px_rgba(0,0,0,0.3)]">
            <div class="p-6 pb-0">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                    <h3 class="font-headline font-bold text-base">Historial de Confirmaciones</h3>
                    <form method="get" asp-controller="Reservas" asp-action="Index" class="flex items-center gap-2">
                        <input type="hidden" name="filtroEstado" value="@ViewBag.FiltroEstado" />
                        <input type="month" name="mes" value="@Model.MesSeleccionado" class="input-field text-xs py-1.5" style="max-width:150px" />
                        <button type="submit" class="tab-btn text-xs py-1.5">Ver</button>
                    </form>
                </div>
                <div class="flex gap-2 mb-4">
                    <a asp-controller="Reservas" asp-action="Index" asp-route-mes="@Model.MesSeleccionado"
                       class="btn-secondary text-xs py-1.5 px-3 @(ViewBag.FiltroEstado == "Todas" ? "btn-primary" : "")">
                        Todas
                    </a>
                    <a asp-controller="Reservas" asp-action="Index" asp-route-filtroEstado="ACEPTADO" asp-route-mes="@Model.MesSeleccionado"
                       class="btn-secondary text-xs py-1.5 px-3 @(ViewBag.FiltroEstado == "ACEPTADO" ? "btn-primary" : "")">
                        Confirmadas
                    </a>
                    <a asp-controller="Reservas" asp-action="Index" asp-route-filtroEstado="NO_ASISTE" asp-route-mes="@Model.MesSeleccionado"
                       class="btn-secondary text-xs py-1.5 px-3 @(ViewBag.FiltroEstado == "NO_ASISTE" ? "btn-primary" : "")">
                        No asisten
                    </a>
                    <a asp-controller="Reservas" asp-action="Index" asp-route-filtroEstado="PENDIENTE" asp-route-mes="@Model.MesSeleccionado"
                       class="btn-secondary text-xs py-1.5 px-3 @(ViewBag.FiltroEstado == "PENDIENTE" ? "btn-primary" : "")">
                        Pendientes
                    </a>
                </div>
            </div>
            <div class="overflow-x-auto">
                @if (!Model.TodasConfirmaciones.Any())
                {
                    <p class="text-outline text-sm p-6 pt-0">No hay confirmaciones registradas para ese mes.</p>
                }
                else
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>WOD</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.TodasConfirmaciones)
                            {
                                <tr>
                                    <td>@c.NombreCliente</td>
                                    <td>@c.NombreWod</td>
                                    <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (c.Estado == "ACEPTADO")
                                        {
                                            <span class="tag ok">Confirmado</span>
                                        }
                                        else if (c.Estado == "NO_ASISTE")
                                        {
                                            <span class="tag no">No asiste</span>
                                        }
                                        else
                                        {
                                            <span class="tag mu">Pendiente</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
</div>
