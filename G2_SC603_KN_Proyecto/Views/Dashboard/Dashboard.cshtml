@model G2_SC603_KN_Proyecto.Models.DashboardViewModel
@{
    Layout = "_Layout";
}
<div id="page-dashboard" class="section-page active p-6 lg:p-8 space-y-8">
    <div>
        <h2 class="font-headline text-3xl font-bold tracking-tight">Overview</h2>
        <p class="text-on-surface-variant text-xs uppercase tracking-[0.15em] mt-1">Métricas en vivo del estudio</p>
    </div>

    @if (Model.AlertasStock != null && Model.AlertasStock.Any())
    {
        <div class="bg-amber-600/20 border border-amber-500 rounded-2xl p-4">
            <div class="flex items-center gap-2 mb-3">
                <span class="material-symbols-outlined text-amber-400 text-[22px]">warning</span>
                <h3 class="font-headline font-bold text-sm text-amber-300">
                    Stock bajo en @Model.AlertasStock.Count producto(s)
                </h3>
            </div>
            <div class="flex flex-wrap gap-3">
                @foreach (var alerta in Model.AlertasStock)
                {
                    <div class="bg-amber-600/30 rounded-xl px-3 py-2 text-xs">
                        <span class="font-semibold">@alerta.Producto</span>
                        — Cantidad: <span class="text-amber-300 font-bold">@alerta.CantidadActual</span>
                        (mínimo: @alerta.StockMinimo)
                    </div>
                }
            </div>
        </div>
    }

    <!-- Metric Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="kpi">
            <div class="kpi-t">Clientes activos <span class="material-symbols-outlined">group</span></div>
            <div class="kpi-v">@Model.ClientesActivos</div>
            <div class="kpi-f">Con mensualidad registrada</div>
        </div>
        <div class="kpi">
            <div class="kpi-t">Ingresos del mes <span class="material-symbols-outlined">monetization_on</span></div>
            <div class="kpi-v">₡@Model.IngresosMes.ToString("N0")</div>
            <div class="kpi-f">Pagos verificados este mes</div>
        </div>
        <div class="kpi">
            <div class="kpi-t">Asistencia diaria <span class="material-symbols-outlined">directions_run</span></div>
            <div class="kpi-v">@Model.AsistenciaHoy</div>
            <div class="kpi-f">@Model.ConfirmadosWodManana confirmado(s) para mañana</div>
            @if (Model.AsistenciaSemanal != null && Model.AsistenciaSemanal.Any())
            {
                int maxAsistencia = Model.AsistenciaSemanal.Max(a => a.Cantidad);
                <div class="spark">
                    @foreach (var dia in Model.AsistenciaSemanal)
                    {
                        int alturaPct = maxAsistencia == 0 ? 4 : Math.Max(4, (int)(dia.Cantidad * 100.0 / maxAsistencia));
                        <i style="height:@(alturaPct)%" title="@dia.Dia: @dia.Cantidad"></i>
                    }
                </div>
            }
        </div>
        <div class="kpi">
            <div class="kpi-t">Vencen en 7 días <span class="material-symbols-outlined" style="color:var(--warn)">event_busy</span></div>
            <div class="kpi-v" style="color:var(--warn)">@Model.MembresiasPorVencer</div>
            <div class="kpi-f">Requieren renovación pronto</div>
        </div>
    </div>

    <!-- Lo más importante primero: quién viene, qué hay que cobrar, cuánto entró hoy -->
    <div class="bg-surface-container rounded-2xl p-6 shadow-[0_20px_40px_rgba(0,0,0,0.3)]">
        <div class="flex items-center justify-between mb-5">
            <h3 class="font-headline font-bold text-base">Quiénes van a asistir</h3>
            <span class="material-symbols-outlined text-secondary text-[20px]">groups</span>
        </div>
        <p class="text-on-surface-variant text-xs mb-5">
            Clientes confirmados para hoy y los próximos días.
        </p>
        @if (Model.ConfirmadosPorDia != null && Model.ConfirmadosPorDia.Any())
        {
            <div class="space-y-4">
                @foreach (var item in Model.ConfirmadosPorDia)
                {
                    bool esHoy = item.Fecha == DateOnly.FromDateTime(DateTime.Today);
                    <div class="bg-surface-container-high rounded-xl p-4">
                        <div class="flex items-center justify-between mb-1">
                            <span class="font-headline font-bold text-sm capitalize">
                                @item.Fecha.ToString("dddd dd/MM", new System.Globalization.CultureInfo("es-ES"))
                            </span>
                            @if (esHoy)
                            {
                                <span class="text-[10px] uppercase font-bold text-primary-container bg-primary-container/15 rounded-full px-2 py-0.5">Hoy</span>
                            }
                        </div>
                        <p class="text-on-surface-variant text-xs mb-3">@item.Confirmados confirmado(s)</p>
                        <div style="max-height:220px; overflow-y:auto; max-width:640px;">
                            <table class="w-full text-xs">
                                <thead>
                                    <tr class="text-left">
                                        <th class="pb-1 pr-2 font-semibold text-on-surface-variant">Cliente</th>
                                        @foreach (var wod in item.Wods)
                                        {
                                            <th class="pb-1 px-1 text-center font-semibold text-on-surface-variant" title="@wod">
                                                @(wod.Length > 10 ? wod.Substring(0, 10) + "…" : wod)
                                            </th>
                                        }
                                        @if (esHoy)
                                        {
                                            <th class="pb-1 pl-2 text-center font-semibold text-on-surface-variant">Check-in</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cliente in item.Clientes)
                                    {
                                        <tr class="border-t border-outline-variant/10">
                                            <td class="py-1.5 pr-2">
                                                @cliente.Nombre
                                                @if (!string.IsNullOrEmpty(cliente.Horarios))
                                                {
                                                    <div class="text-on-surface-variant text-[10px]">@cliente.Horarios.Replace(",", ", ")</div>
                                                }
                                            </td>
                                            @for (int i = 0; i < item.Wods.Count; i++)
                                            {
                                                <td class="text-center">
                                                    @if (cliente.ConfirmoPorWod[i])
                                                    {
                                                        <span class="text-[#4ade80]">✓</span>
                                                    }
                                                </td>
                                            }
                                            @if (esHoy)
                                            {
                                                <td class="text-center pl-2">
                                                    @if (cliente.YaIngreso)
                                                    {
                                                        <span class="text-[#4ade80]">✓</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-outline">—</span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-on-surface-variant text-sm">Todavía no hay confirmaciones para hoy ni para los próximos días.</p>
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-surface-container rounded-2xl p-6 shadow-[0_20px_40px_rgba(0,0,0,0.3)]">
            <div class="flex items-center justify-between mb-5">
                <h3 class="font-headline font-bold text-base">Alertas de Vencimiento</h3>
                <span class="material-symbols-outlined text-[#fbbf24] text-[20px]">warning_amber</span>
            </div>

            @if (Model.MembresiasPendientesDePago > 0)
            {
                <a asp-controller="Membresia" asp-action="MostrarMembresia"
                   class="block rounded-xl p-3 mb-4 hover:opacity-80 cursor-pointer"
                   style="background: rgba(234,179,8,0.12); border: 1px solid rgba(234,179,8,0.35);">
                    <span class="text-[#ca8a04] font-semibold text-sm">
                        @Model.MembresiasPendientesDePago cliente(s) con mensualidad pendiente de pago
                    </span>
                    <p class="text-on-surface-variant text-xs mt-1">
                        Ya reservaron pero todavía no eligieron cómo van a pagar, o falta confirmarles el pago.
                    </p>
                </a>
            }

            @if (Model.Vencimientos != null && Model.Vencimientos.Any())
            {
                @foreach (var item in Model.Vencimientos)
                {
                    <a asp-controller="Clientes" asp-action="MostrarClientes"
                       class="block border-b pb-3 mb-3 hover:opacity-80 cursor-pointer">
                        <strong>@item.Cliente</strong><br />
                        Vence: @item.FechaFin.ToString("dd/MM/yyyy")<br />
                        <small>@item.DiasRestantes días restantes</small>
                    </a>
                }
            }
            else if (Model.MembresiasPendientesDePago == 0)
            {
                <p class="text-on-surface-variant text-sm">No hay alertas de vencimiento en los próximos 7 días.</p>
            }
        </div>

        <div class="bg-surface-container rounded-2xl p-6 shadow-[0_20px_40px_rgba(0,0,0,0.3)]">
            <div class="flex items-center justify-between mb-5">
                <h3 class="font-headline font-bold text-base">Ingresos de Hoy</h3>
                <span class="text-on-surface-variant text-xs" id="todayDate"></span>
            </div>
            <div class="text-center py-4">
                <div class="font-headline text-5xl font-black tracking-tighter text-primary-container">
                    ₡@Model.IngresosHoy.ToString("N0")
                </div>
                <p class="text-on-surface-variant text-xs mt-2">
                    @if (Model.IngresosHoy == 0)
                    {
                        <span>No se han registrado pagos hoy</span>
                    }
                    else
                    {
                        <span>Total cobrado hoy</span>
                    }
                </p>
            </div>
            <div class="mt-4 space-y-2">
                @foreach (var pago in Model.PagosHoy)
                {
                    <div class="flex justify-between border-b py-2">
                        <span>@pago.Cliente</span>
                        <span>₡@pago.Monto.ToString("N0")</span>
                        <span>@pago.Metodo</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Analítica: útil, pero no es lo primero que hay que ver cada día -->
    <details class="bg-surface-container rounded-2xl shadow-[0_20px_40px_rgba(0,0,0,0.3)]">
        <summary class="cursor-pointer list-none p-6 flex items-center justify-between">
            <div>
                <h3 class="font-headline font-bold text-base">Estadísticas y gráficos</h3>
                <p class="text-on-surface-variant text-xs mt-1">Asistencia en el tiempo y ranking de clientes.</p>
            </div>
            <span class="material-symbols-outlined text-on-surface-variant text-[22px] dashboard-details-chevron">expand_more</span>
        </summary>

        <div class="px-6 pb-6 space-y-6">
            <div class="bg-surface-container-high rounded-2xl p-6">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h3 class="font-headline font-bold text-lg">Asistencia</h3>
                        <p class="text-on-surface-variant text-xs">Ingresos al gimnasio por dia &middot; semana, mes o rango de fechas</p>
                    </div>
                    <div class="flex gap-1">
                        <button id="btnSemana" class="tab-btn active" onclick="cambiarPeriodo('semana')">Semana</button>
                        <button id="btnMes" class="tab-btn" onclick="cambiarPeriodo('mes')">Mes</button>
                        <button id="btnRango" class="tab-btn" onclick="cambiarPeriodo('rango')">Rango</button>
                    </div>
                </div>

                <form method="get" asp-controller="Dashboard" asp-action="Dashboard" class="flex flex-wrap items-center gap-2 mb-4">
                    <input type="date" name="fechaInicio" id="fechaInicio" class="input-field text-xs py-1.5" style="max-width:160px"
                           value="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))"
                           max="@(Model.FechaFin?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" required />
                    <input type="date" name="fechaFin" id="fechaFin" class="input-field text-xs py-1.5" style="max-width:160px"
                           value="@(Model.FechaFin?.ToString("yyyy-MM-dd"))"
                           min="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))"
                           max="@(DateTime.Today.ToString("yyyy-MM-dd"))" required />
                    <button type="submit" class="tab-btn">Aplicar</button>
                </form>

                @if (Model.RangoInvalido)
                {
                    <p class="text-xs mb-3" style="color:#ffb4ab;">El rango de fechas no es válido.</p>
                }

                <div style="height:300px"><canvas id="attendanceChart"></canvas></div>
                <p id="chartEmptyMsg" class="text-on-surface-variant text-xs text-center mt-2" style="display:none;">
                    No hay asistencias registradas para el período seleccionado.
                </p>
            </div>

            <div class="bg-surface-container-high rounded-2xl p-6">
                <h3 class="font-headline font-bold text-base mb-1">Top Clientes — Asistencia al Gimnasio</h3>
                <p class="text-on-surface-variant text-[11px] mb-3">Cuenta el check-in físico, no las confirmaciones de WOD.</p>

                <form method="get" asp-controller="Dashboard" asp-action="Dashboard"
                      class="flex flex-wrap gap-2 items-end mb-4">
                    <div>
                        <label class="label-float text-[10px]">Desde</label>
                        <input type="date" name="rankingInicio" id="rankingInicio" class="input-field text-xs py-1.5" style="max-width:140px"
                               value="@(Model.RankingInicio?.ToString("yyyy-MM-dd"))"
                               max="@(Model.RankingFin?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div>
                        <label class="label-float text-[10px]">Hasta</label>
                        <input type="date" name="rankingFin" id="rankingFin" class="input-field text-xs py-1.5" style="max-width:140px"
                               value="@(Model.RankingFin?.ToString("yyyy-MM-dd"))"
                               min="@(Model.RankingInicio?.ToString("yyyy-MM-dd"))"
                               max="@(DateTime.Today.ToString("yyyy-MM-dd"))" />
                    </div>
                    <button type="submit" class="tab-btn text-xs py-1.5">Filtrar</button>
                    @if (Model.RankingInicio.HasValue || Model.RankingFin.HasValue)
                    {
                        <a asp-controller="Dashboard" asp-action="Dashboard" class="tab-btn text-xs py-1.5">Limpiar</a>
                    }
                </form>

                @if (Model.RankingInicio.HasValue && Model.RankingFin.HasValue && Model.RankingInicio > Model.RankingFin)
                {
                    <p class="text-xs mb-3" style="color:#ffb4ab;">"Desde" no puede ser posterior a "Hasta" — se ignoró el filtro.</p>
                }

                @if (Model.RankingClientes != null && Model.RankingClientes.Any())
                {
                    @foreach (var item in Model.RankingClientes)
                    {
                        <div class="flex justify-between border-b py-2">
                            <span>@item.Cliente</span>
                            <span>@item.Asistencias asistencias</span>
                        </div>
                    }
                }
                else
                {
                    <p class="text-on-surface-variant text-sm">No hay datos de asistencia para el período seleccionado.</p>
                }
            </div>
        </div>
    </details>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const asistenciaSemana = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AsistenciaSemanal));
    const asistenciaMes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AsistenciaMensual));
    const asistenciaRango = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AsistenciaRango));

    document.getElementById('todayDate').textContent = new Date().toLocaleDateString('es-CR', {
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
    });

    // Evita que "Desde" quede después de "Hasta" (o viceversa) en los
    // filtros de fecha, bloqueándolo directo en el selector nativo.
    function sincronizarRangoFechas(idInicio, idFin) {
        var inputInicio = document.getElementById(idInicio);
        var inputFin = document.getElementById(idFin);
        if (!inputInicio || !inputFin) return;

        inputInicio.addEventListener('change', function () {
            inputFin.min = inputInicio.value;
        });
        inputFin.addEventListener('change', function () {
            inputInicio.max = inputFin.value;
        });
    }
    sincronizarRangoFechas('fechaInicio', 'fechaFin');
    sincronizarRangoFechas('rankingInicio', 'rankingFin');

    // El gráfico está dentro de un <details> colapsado: Chart.js lo mide
    // en 0x0 mientras está cerrado. Al abrirlo, hay que forzar un resize.
    document.querySelector('details').addEventListener('toggle', function (e) {
        if (e.target.open) {
            var chart = Chart.getChart('attendanceChart');
            if (chart) chart.resize();
        }
    });
</script>
<script src="~/js/graficos.js" asp-append-version="true"></script>