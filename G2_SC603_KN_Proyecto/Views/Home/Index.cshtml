@{
    Layout = "_LayoutExterno";
}

<body class="bg-surface text-on-surface min-h-screen">

    @if (ViewBag.Error != null)
    {
        <div class="toast show" style="background:#201f1f; color:#ffb4ab;">
            <span class="material-symbols-outlined">error</span>
            <span>@ViewBag.Error</span>
        </div>
    }

    <div class="login-split">

        <!-- Panel de marca -->
        <div class="login-art">
            <img class="login-watermark" src="~/img/logo.jpg" alt="" />

            <div class="login-art-top">
                <img class="login-art-logo" src="~/img/logo.jpg" alt="Orion Fit Studio" />
                <div>
                    <div class="login-art-brand">Orion Fit Studio</div>
                    <div class="login-art-sub">Elite Management</div>
                </div>
            </div>

            <div class="login-art-mid">
                <h1>El estudio, <em>bajo control</em> desde una sola pantalla.</h1>
                <p>Clientes, mensualidades, pagos SINPE, WOD del día y reservas. Sin hojas de cálculo.</p>
            </div>

            <div class="login-art-stats">
                <div><span>Clientes</span><small>Mensualidades y estado</small></div>
                <div><span>Pagos</span><small>SINPE y efectivo</small></div>
                <div><span>WOD</span><small>Programación diaria</small></div>
            </div>
        </div>

        <!-- Formulario -->
        <div class="login-form-panel">
            <div class="login-form-box">

                <h2 class="font-headline text-2xl font-bold mb-1">Iniciar sesión</h2>
                <p class="text-on-surface-variant text-sm mb-8">Ingresá con tu usuario del estudio.</p>

                <form id="loginForm" asp-action="Index" method="post" class="space-y-5">
                    <div>
                        <label class="label-float" for="loginUser">Usuario</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]" style="font-variation-settings:'wght' 300">person</span>
                            <input class="input-field pl-10" id="loginUser" name="username" type="text" placeholder="Ingrese su usuario" />
                        </div>
                    </div>
                    <div>
                        <label class="label-float flex justify-between" for="loginPass">
                            <span>Contraseña</span>
                            <a asp-controller="Account" asp-action="Recuperar"
                               class="text-primary-container text-xs font-medium hover:text-primary transition-colors normal-case tracking-normal">
                                ¿Olvidó su clave?
                            </a>
                        </label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]" style="font-variation-settings:'wght' 300">lock</span>
                            <input class="input-field pl-10 pr-10" id="loginPass" name="password" type="password" placeholder="••••••••" />
                            <button type="button" id="togglePassword"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface transition-colors">
                                <span id="toggleIcon" class="material-symbols-outlined text-[20px]" style="font-variation-settings:'wght' 300">visibility_off</span>
                            </button>
                        </div>
                    </div>
                    <div class="pt-2">
                        <button type="submit" class="btn-primary w-full justify-center text-base py-3.5">
                            Iniciar Sesión
                        </button>
                    </div>
                    <p class="text-center text-xs text-outline mt-4">© @DateTime.Now.Year, Orion Fit</p>
                </form>

            </div>
        </div>

    </div>
</body>
